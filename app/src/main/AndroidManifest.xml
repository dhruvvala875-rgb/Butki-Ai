
override fun onError(error: Int) {
    neonVisualizer.updateVoiceLevel(1f)

    if (error == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS) {
        txtStatus.text = "● MIC PERMISSION DENIED"
        txtResponse.text =
            "Microphone permission allow karein: Settings > Apps > Butki AI > Permissions."
        return
    }

    if (isSpeaking || isFinishing || isDestroyed) return

    when (error) {
        SpeechRecognizer.ERROR_NO_MATCH,
        SpeechRecognizer.ERROR_SPEECH_TIMEOUT -> {
            txtStatus.text = "● LISTENING FOR HEY BUTKI..."
            restartListeningWithDelay(700)
        }

        SpeechRecognizer.ERROR_RECOGNIZER_BUSY,
        SpeechRecognizer.ERROR_CLIENT,
        SpeechRecognizer.ERROR_SERVER -> {
            txtStatus.text = "● RESTARTING MICROPHONE..."
            txtResponse.text =
                "Voice service restart ho rahi hai. Kripya ek second rukiye."

            mainHandler.removeCallbacksAndMessages(null)
            mainHandler.postDelayed({
                if (!isFinishing && !isDestroyed && !isSpeaking) {
                    setupContinuousSpeechRecognizer()
                }
            }, 1200)
        }

        else -> {
            txtStatus.text = "● SPEECH ERROR: $error"
            txtResponse.text =
                "Voice recognition mein problem hai. B par tap karke dobara boliye."
            restartListeningWithDelay(1500)
        }
    }
}
