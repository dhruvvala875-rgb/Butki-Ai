<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Cyan Glow Ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#00F0FF" />
            <solid android:color="#1000F0FF" />
            <size android:width="180dp" android:height="180dp" />
        </shape>
    </item>
    <!-- Middle Neon Pink Ring -->
    <item android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#FF007F" />
            <solid android:color="#121224" />
        </shape>
    </item>
    <!-- Inner Core Ring -->
    <item android:top="28dp" android:bottom="28dp" android:left="28dp" android:right="28dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#00F0FF" />
            <solid android:color="#1A1A35" />
        </shape>
    </item>
</layer-list>
