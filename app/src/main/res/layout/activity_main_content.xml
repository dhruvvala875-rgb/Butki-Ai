<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020205">

    <!-- Status Text at Top -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:text="[ SYS: INITIALIZING... ]"
        android:textColor="#00F0FF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <!-- Glowing Delta Symbol in Center -->
    <android.template.butki.views.DeltaSymbolView
        android:id="@+id/delta_symbol"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true" />

    <!-- Tasks Left / Pro Tags -->
    <LinearLayout
        android:id="@+id/tasks_left_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/delta_symbol"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasks_left_tag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlimited"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Set Default Assistant Button -->
    <TextView
        android:id="@+id/btn_set_default_assistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:padding="12dp"
        android:text="[ SET AS DEFAULT ASSISTANT ]"
        android:textColor="#00F0FF"
        android:fontFamily="monospace"
        android:background="#1100F0FF" />

    <!-- Hidden / Utility placeholders to prevent layout reference errors -->
    <View
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC020205"
        android:visibility="gone" />

    <TextView android:id="@+id/btn_manage_permissions" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/tv_permission_status" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/increase_limits_link" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/vision_trigger_link" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/wakeWordHelpLink" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/disclaimer_link" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/examples_link" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/pro_upgrade_banner" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/upgrade_button" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/pro_subscription_tag" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/permissions_tag" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/permissions_status_tag" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/billing_status_textview" android:layout_width="0dp" android:layout_height="0dp" />

</RelativeLayout>
